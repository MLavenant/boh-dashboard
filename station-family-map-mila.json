{
  "venue": "mila",
  "description": "Maps Toast prep-station names → FTE Matrix station families for staffing join.",
  "families": {
    "Saute": {
      "match": ["saute", "sauteed", "hot line", "hot"]
    },
    "Fry": {
      "match": ["tempura", "fry"]
    },
    "Garde Manger": {
      "match": ["garde manger", "pantry", "salad"]
    },
    "Raw": {
      "match": ["crudo", "raw"]
    },
    "Sushi": {
      "match": ["sushi bar, cold", "sushi bar", "sushi", "maki", "omakase", "nigiri"]
    },
    "Robata": {
      "match": ["robata", "grill"]
    },
    "Pastry": {
      "match": ["pastry", "2f-passion", "2f-gelato", "2f passion", "2f gelato", "gelato", "passion"]
    },
    "Expo": {
      "match": ["expo", "hot expo", "cold expo", "mm to"]
    },
    "Pizza": {
      "match": ["pizza"]
    },
    "Prep": {
      "match": ["prep", "butcher", "condiments"]
    }
  },
  "ignore": ["no print", "event", "ico", "dock"]
}
